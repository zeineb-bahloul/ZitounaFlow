rules_version = '2';

// Règles de sécurité Cloud Firestore — ZitounaFlow
// À copier dans la console Firebase > Firestore Database > Règles.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isGestionnaire() {
      return signedIn()
        && get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data.role == 'GESTIONNAIRE';
    }

    // Sprint 1 : profils utilisateurs (document = uid Firebase Auth)
    match /utilisateurs/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isGestionnaire());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['AGRICULTEUR', 'GESTIONNAIRE'];
      // Le rôle et l'e-mail ne peuvent pas être modifiés
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // Sprint 2 : rendez-vous
    match /rendezVous/{rdvId} {
      allow read: if isGestionnaire()
        || (signedIn() && resource.data.agriculteurId == request.auth.uid);
      // L'agriculteur crée sa propre demande, toujours « en attente »
      allow create: if signedIn()
        && request.resource.data.agriculteurId == request.auth.uid
        && request.resource.data.statut == 'EN_ATTENTE_CONFIRMATION';
      // Le gestionnaire confirme/refuse ; l'agriculteur peut seulement annuler la sienne
      allow update: if isGestionnaire()
        || (signedIn() && resource.data.agriculteurId == request.auth.uid
            && request.resource.data.statut == 'ANNULE');
      allow delete: if false;
    }

    // Compteurs de réservations par créneau (un document par jour)
    match /planning/{jour} {
      allow read, write: if signedIn();
    }

    // Sprint 3 : lots d'olives (un lot appartient à un seul agriculteur)
    match /lots/{lotId} {
      allow read: if isGestionnaire()
        || (signedIn() && resource.data.agriculteurId == request.auth.uid);
      // Seul le gestionnaire crée les lots et modifie statuts et file d'attente
      allow create, update: if isGestionnaire();
      allow delete: if false;

      match /historique/{histId} {
        allow read: if isGestionnaire()
          || (signedIn() && get(/databases/$(database)/documents/lots/$(lotId)).data.agriculteurId == request.auth.uid);
        allow create: if isGestionnaire();
        allow update, delete: if false;
      }
    }

    // Numérotation des lots
    match /compteurs/{compteurId} {
      allow read, write: if isGestionnaire();
    }

    // Notifications : personnelles (destinataireId = uid) ou collectives pour tous
    // les gestionnaires (destinataireId = 'GESTIONNAIRES')
    match /notifications/{notifId} {
      function estDestinataire(data) {
        return data.destinataireId == request.auth.uid
          || (data.destinataireId == 'GESTIONNAIRES' && isGestionnaire());
      }
      allow read: if signedIn() && estDestinataire(resource.data);
      allow update: if signedIn() && estDestinataire(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lue']);
      // Le gestionnaire notifie les agriculteurs ; un agriculteur peut notifier les gestionnaires
      allow create: if isGestionnaire()
        || (signedIn() && request.resource.data.destinataireId == 'GESTIONNAIRES');
      allow delete: if false;
    }
  }
}
