<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Boutons -->
    <style name="Widget.Zitouna.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/olive_700</item>
    </style>

    <style name="Widget.Zitouna.Button.Gold">
        <item name="backgroundTint">@color/gold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Zitouna.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">@color/olive_500</item>
        <item name="android:textColor">@color/olive_700</item>
    </style>

    <style name="Widget.Zitouna.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/olive_700</item>
    </style>

    <style name="Widget.Zitouna.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">56dp</item>
        <item name="backgroundTint">@color/toggle_bg</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="iconTint">@color/toggle_text</item>
    </style>

    <!-- Champs de saisie -->
    <style name="Widget.Zitouna.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/olive_700</item>
        <item name="hintTextColor">@color/olive_700</item>
    </style>

    <!-- Cartes -->
    <style name="Widget.Zitouna.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Typographie -->
    <style name="TextAppearance.Zitouna.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.Zitouna.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.Zitouna.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Zitouna.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/gold_dark</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Zitouna.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Zitouna.Value" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/olive_900</item>
    </style>
</resources>
