<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gestion_overline"
        android:textAppearance="@style/TextAppearance.Zitouna.Overline" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gestion_titre"
        android:textAppearance="@style/TextAppearance.Zitouna.Display"
        android:textSize="26sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnJourPrecedent"
            style="@style/Widget.Zitouna.IconButton"
            android:contentDescription="Jour précédent"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/txtJour"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_gold"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:textColor="@color/gold_dark"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_calendar"
            app:drawableTint="@color/gold_dark"
            tools:text="Aujourd'hui • lun. 16 nov." />

        <ImageButton
            android:id="@+id/btnJourSuivant"
            style="@style/Widget.Zitouna.IconButton"
            android:contentDescription="Jour suivant"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAujourdhui"
        style="@style/Widget.Zitouna.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/aujourdhui" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/capacite_titre"
                    android:textAppearance="@style/TextAppearance.Zitouna.Title" />

                <TextView
                    android:id="@+id/txtPourcent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:textColor="@color/olive_900"
                    android:textSize="24sp"
                    tools:text="84%" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtCapacite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Zitouna.Body"
                    android:textSize="12sp"
                    tools:text="18 400 / 22 000 kg réservés" />

                <TextView
                    android:id="@+id/txtReste"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gold_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Reste 3 600 kg" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressCapacite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                app:indicatorColor="@color/olive_700"
                app:trackColor="@color/olive_100"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtConfirme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/olive_700"
                    android:textSize="12sp"
                    tools:text="Confirmé (15 800 kg)" />

                <TextView
                    android:id="@+id/txtEnAttente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gold_dark"
                    android:textSize="12sp"
                    tools:text="En attente (2 600 kg)" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupStatut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipEnAttente"
            style="@style/Widget.Zitouna.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/filtre_en_attente" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipConfirmes"
            style="@style/Widget.Zitouna.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filtre_confirmes" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTous"
            style="@style/Widget.Zitouna.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filtre_tous" />

    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/olive_700" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_circle_gold_light">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar"
                app:tint="@color/gold_dark" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/gestion_vide"
            android:textAppearance="@style/TextAppearance.Zitouna.Title" />

    </LinearLayout>


    </LinearLayout>
</ScrollView>
