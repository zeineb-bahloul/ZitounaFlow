<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtStatut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_gold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="En attente" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtJour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Zitouna.Overline"
                tools:text="Demain" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="serif"
            android:textColor="@color/ink"
            android:textSize="19sp"
            tools:text="Domaine Ben Salem" />

        <TextView
            android:id="@+id/txtSousTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zitouna.Body"
            android:textSize="12sp"
            tools:text="Hédi Ben Salem • +216 98 123 456" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_kpi"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CRÉNEAU"
                    android:textAppearance="@style/TextAppearance.Zitouna.Overline"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtCreneau"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textStyle="bold"
                    tools:text="14:00 - 16:00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VARIÉTÉ"
                    android:textAppearance="@style/TextAppearance.Zitouna.Overline"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtVariete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textStyle="bold"
                    tools:text="Chétoui" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUANTITÉ"
                    android:textAppearance="@style/TextAppearance.Zitouna.Overline"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtQuantite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/olive_900"
                    android:textStyle="bold"
                    tools:text="1 450 kg" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtCaisses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.Zitouna.Body"
            android:textSize="12sp"
            tools:text="≈ 29 caisses de 50 kg" />

        <TextView
            android:id="@+id/txtRemarque"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/olive_700"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="« Cueillette matinale, souhait de pressage immédiat »"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/txtMotif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/error"
            android:visibility="gone"
            tools:text="Motif du refus : quai saturé" />

        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnnuler"
                style="@style/Widget.Zitouna.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/rdv_annuler"
                android:textColor="@color/error"
                app:strokeColor="@color/error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefuser"
                style="@style/Widget.Zitouna.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/refuser"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/olive_700" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/confirmer"
                app:icon="@drawable/ic_check" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
