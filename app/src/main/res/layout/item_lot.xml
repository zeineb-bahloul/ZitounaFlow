<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtPosition"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:textColor="@color/white"
                android:textStyle="bold"
                tools:text="2" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtNumero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Zitouna.Overline"
                        tools:text="#LOT-012" />

                    <ImageView
                        android:id="@+id/imgPrioritaire"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="Prioritaire"
                        android:src="@drawable/ic_star"
                        android:visibility="gone"
                        app:tint="@color/gold"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtTitre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    tools:text="Domaine Ben Salem" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtStatut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_gold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="En attente" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtSousTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Zitouna.Body"
            android:textSize="12sp"
            tools:text="Chétoui • Reçu aujourd'hui à 08h30" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_kpi"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POIDS NET"
                    android:textAppearance="@style/TextAppearance.Zitouna.Overline"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtPoids"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/olive_900"
                    android:textStyle="bold"
                    tools:text="1 330 kg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblInfo2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRÉVU"
                    android:textAppearance="@style/TextAppearance.Zitouna.Overline"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtInfo2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/olive_900"
                    android:textStyle="bold"
                    tools:text="15h45" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblInfo3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ATTENTE"
                    android:textAppearance="@style/TextAppearance.Zitouna.Overline"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtInfo3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/olive_900"
                    android:textStyle="bold"
                    tools:text="≈ 1h 20" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutProgression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressTraitement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                app:indicatorColor="@color/gold"
                app:trackColor="@color/olive_100"
                app:trackCornerRadius="4dp"
                app:trackThickness="6dp"
                tools:progress="65" />

            <TextView
                android:id="@+id/txtProgression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/gold_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="65 % • ≈ 30 min restant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMonter"
                style="@style/Widget.Zitouna.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Monter dans la file"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_up" />

            <ImageButton
                android:id="@+id/btnDescendre"
                style="@style/Widget.Zitouna.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Descendre dans la file"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_down" />

            <ImageButton
                android:id="@+id/btnPrioriser"
                style="@style/Widget.Zitouna.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Prioriser ce lot"
                android:padding="9dp"
                android:src="@drawable/ic_star" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAvancer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:paddingHorizontal="10dp"
                android:textSize="13sp"
                app:icon="@drawable/ic_play"
                tools:text="Lancer le traitement" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
